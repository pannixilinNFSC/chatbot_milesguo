#
# Copy this file to `.env` and fill in values.
# Notes:
# - Keep comments in English for operational clarity.
# - Never commit real secrets.
#

# --- LLM providers ---
# Required: used by LiteLLM (primary model).
OPENAI_API_KEY=

# Optional: used for Gemini fallback / query expansion (if enabled in your codepath).
GOOGLE_API_KEY=

# --- Elasticsearch (Serverless / Hosted) ---
ELASTIC_URL=
ELASTIC_API_KEY=

# --- API server ---
# Optional: If set, /chatbot, /search, /search_naive require:
#   Authorization: Bearer <API_AUTH_TOKEN>
# If empty, auth is disabled (useful for local dev).
API_AUTH_TOKEN=

# CORS for browser frontends:
# - "*" allows all origins (easy, less secure)
# - or comma-separated origins, e.g.:
#   https://example.com,https://www.example.com
CORS_ALLOW_ORIGINS=*

# Rate limiting (defaults are 5/min and 30/hour)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30

# Local server port (Cloud Functions sets PORT automatically).
PORT=8080